POE_API_KEY=replace-with-poe-api-key
SELF_DASHBOARD_VIEW_KEY=replace-with-random-128-bit-view-key
SESSION_SECRET=replace-with-random-256-bit-secret
PORT=3000
# Bind to this hostname. Defaults to 127.0.0.1 (loopback only). Set to 0.0.0.0
# to listen on all interfaces (e.g. behind a reverse proxy on another host).
HOST=127.0.0.1
# Comma-separated list of trusted proxy IPs. When a request arrives from one
# of these IPs, X-Forwarded-For is trusted for rate-limiting. Default: empty
# (trust nothing, use the direct socket IP).
TRUSTED_PROXIES=

# --- A class: account balance providers ---
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
NOVITA_API_KEY=

# --- B class: coding plan providers ---
KIMI_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://your-zenmux-instance.example.com

# --- Volcengine (AK/SK, not apiKey) ---
VOLCENGINE_AK=
VOLCENGINE_SK=

# --- CLIProxyAPI (management key for upstream account discovery + quota query) ---
CLIPROXY_BASE_URL=http://localhost:8317
CLIPROXY_MGMT_KEY=
